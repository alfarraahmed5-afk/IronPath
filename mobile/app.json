{
  "expo": {
    "name": "IronPath",
    "slug": "ironpath",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "ironpath",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ironpath.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "IronPath uses your camera to take workout photos and videos.",
        "NSPhotoLibraryUsageDescription": "IronPath accesses your photo library when uploading workout media.",
        "NSPhotoLibraryAddUsageDescription": "IronPath saves shareable workout graphics to your photo library.",
        "NSMicrophoneUsageDescription": "IronPath uses the microphone when recording workout videos."
      }
    },
    "android": {
      "package": "com.ironpath.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "react-native-edge-to-edge",
      [
        "expo-notifications",
        {
          "color": "#C8102E",
          "androidCollapsedTitle": "IronPath",
          "androidMode": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow IronPath to access your camera for workout photos and videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow IronPath to save workout graphics to your photos.",
          "savePhotosPermission": "Allow IronPath to save shareable workout cards to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c459e930-32ec-46f3-adbf-419ea376505c"
      },
      "notificationChannels": {
        "active-workout": {
          "name": "Active workout",
          "description": "Rest timer and ongoing workout. High importance so the alert fires when you've switched to another app.",
          "importance": "HIGH",
          "sound": "default",
          "vibrationPattern": [0, 250, 250, 250],
          "enableLights": true,
          "lightColor": "#C8102E",
          "lockscreenVisibility": "PUBLIC",
          "bypassDnd": false
        },
        "social": {
          "name": "Social activity",
          "description": "Likes, comments, mentions, follows.",
          "importance": "DEFAULT",
          "sound": "default",
          "lockscreenVisibility": "PRIVATE",
          "bypassDnd": false
        },
        "pr-and-streak": {
          "name": "Personal records and streak",
          "description": "Personal-record celebrations and streak-at-risk reminders.",
          "importance": "HIGH",
          "sound": "default",
          "vibrationPattern": [0, 200, 100, 200],
          "enableLights": true,
          "lightColor": "#C8102E",
          "lockscreenVisibility": "PUBLIC",
          "bypassDnd": false
        }
      }
    }
  }
}
