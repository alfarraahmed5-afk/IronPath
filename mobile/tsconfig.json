{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ds/*": ["src/design-system/*"],
      "@ds": ["src/design-system"],
      "@features/*": ["src/features/*"],
      "@lib/*": ["src/lib/*"],
      "@stores/*": ["src/stores/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
