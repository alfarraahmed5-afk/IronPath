# IronPath marketing site — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local dev, or set these in the Vercel
# project settings for preview/production. Never commit secrets.

# Public — exposed to the client bundle.
# IronPath backend root (no trailing slash). The lead route appends `/leads`.
NEXT_PUBLIC_BACKEND_URL=https://backend-production-f43b.up.railway.app/api/v1

# Admin app root (no trailing slash). After a successful lead-form submit,
# the visitor is redirected here to finish signup.
NEXT_PUBLIC_ADMIN_URL=https://admin.ironpath.health

# Server-only secret. SHA-256 HMAC key used to sign lead payloads forwarded
# from /api/lead to the backend. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match LEAD_HMAC_SECRET on the backend. Rotate by deploying both
# sides simultaneously with the new value.
LEAD_HMAC_SECRET=set-a-32-byte-random-hex-string-here
