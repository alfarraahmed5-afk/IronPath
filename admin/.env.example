# Backend API base URL (no trailing slash). Defaults to http://localhost:3000/api/v1.
VITE_API_URL=

# Sentry DSN — safe to ship in client bundles (not a secret).
# Leave empty in development to silence Sentry. Initialization no-ops without a DSN.
VITE_SENTRY_DSN=

# Optional: override the environment tag Sentry attaches to events.
# Falls back to Vite's MODE (development / production) when unset.
VITE_ENV=

# Optional: commit SHA used as the Sentry release. Set by CI (e.g. Vercel's
# VERCEL_GIT_COMMIT_SHA) so source maps + releases line up.
VITE_COMMIT_SHA=
